# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 短期记忆窗口 / 压缩阈值（可选）
STM_WINDOW=20
STM_MAX_TOKENS=4000

# 发件邮箱不在这里配——每个用户在微信里自己设（set_sender_email 工具），
# 按 user_id 隔离存进 user_settings 表，不共用一个邮箱。

# 通讯录同步令牌（Mac→服务器 推送通讯录时校验）
DIRECTORY_SYNC_TOKEN=

# 自助开通 API 监听端口（prod=8080, beta=7997）
API_PORT=8080

# ── 实时旁观面板（Pusher）─────────────────────────────
# 到 https://pusher.com 建 Channels app，四项都填。空则面板功能关闭，其他不受影响。
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap3
# 面板前端 URL（Vercel serve dashboard.html 后填）
DASHBOARD_URL_BASE=https://weixin-agent-beta.vercel.app/dashboard.html
