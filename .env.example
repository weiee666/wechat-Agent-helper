# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 短期记忆窗口 / 压缩阈值（可选）
STM_WINDOW=20
STM_MAX_TOKENS=4000

# 自助开通 API 监听端口（prod=8080, beta=7997）
API_PORT=8080

# ── 实时旁观面板（Pusher）─────────────────────────────
# 到 https://pusher.com 建 Channels app，四项都填。空则面板功能关闭，其他不受影响。
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap3
# 面板前端 URL（Vercel serve dashboard.html 后填）
DASHBOARD_URL_BASE=https://weixin-agent-beta.vercel.app/dashboard.html

# ── A2A（Agent-to-Agent）对外接口 ─────────────────────────
# 我们服务的对外基础 URL；Agent Card 里的 endpoint URL 从这里拼
# 生产建议 https://域名  开发可以 http://43.142.81.135:7997
A2A_BASE_URL=http://43.142.81.135:7997
A2A_PROVIDER_NAME=weixin-agent
