[Unit]
Description=weixin-agent (iLink multi-tenant bot + onboarding API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/weixin-agent
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/weixin-agent/.venv/bin/python -m app.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
